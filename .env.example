# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# generate_report.py loads .env automatically (via python-dotenv).
# Exporting the variable in your shell works just as well:
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Never commit the real .env — it's in .gitignore.
ANTHROPIC_API_KEY=sk-ant-your-key-here
